          "rawSql": "SELECT DISTINCT ON (dag_id)\n  dag_id,\n  state,\n  start_date,\n  end_date,\n  round(extract(epoch FROM end_date - start_date)) AS duration_sec,\n  run_type\nFROM dag_run\nORDER BY dag_id, start_date DESC",
