    {
      "id": 5,
      "title": "Dataset freshness",
      "description": "Last update and lag per dataset. stock_snapshot lag is naturally high outside US market hours.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CRYPTO}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CRYPTO}"
          },
          "rawSql": "SELECT\n  'coin_snapshot' AS dataset,\n  max(snapshot_at) AS last_update,\n  extract(epoch FROM now() - max(snapshot_at))::int AS lag_seconds\nFROM coin_snapshot\n\nUNION ALL\n\nSELECT\n  'stock_snapshot',\n  max(snapshot_at),\n  extract(epoch FROM now() - max(snapshot_at))::int\nFROM stock_snapshot\n\nUNION ALL\n\nSELECT\n  'hl_positions',\n  max(snapshot_at),\n  extract(epoch FROM now() - max(snapshot_at))::int\nFROM hl_positions\n\nUNION ALL\n\nSELECT\n  'hl_fills',\n  max(ts),\n  extract(epoch FROM now() - max(ts))::int\nFROM hl_fills\n\nORDER BY dataset",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 6,
      "title": "Wallet list freshness",
      "description": "hl_top_wallets has no timestamp, so freshness is measured by the last successful wallets_snapshot run.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_AIRFLOW}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_AIRFLOW}"
          },
          "rawSql": "SELECT\n  dag_id,\n  max(end_date) FILTER (WHERE state = 'success') AS last_success,\n  extract(epoch FROM now() - max(end_date)\n          FILTER (WHERE state = 'success'))::int AS lag_seconds\nFROM dag_run\nWHERE dag_id = 'wallets_snapshot'\nGROUP BY dag_id",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 7,
      "title": "Success rate · 24h",
      "description": "Share of successful DagRuns per DAG. Red below 99%.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_AIRFLOW}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_AIRFLOW}"
          },
          "rawSql": "SELECT\n  dag_id,\n  count(*) AS runs,\n  count(*) FILTER (WHERE state = 'success') AS success,\n  count(*) FILTER (WHERE state = 'failed') AS failed,\n  round(\n    100.0 * count(*) FILTER (WHERE state = 'success') / count(*),\n    1\n  ) AS success_pct\nFROM dag_run\nWHERE start_date > now() - interval '24 hours'\nGROUP BY dag_id\nORDER BY success_pct",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 99
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 8,
      "title": "Runs by state",
      "description": "Scheduled, successful and failed runs per hour. Use it to spot bursts of failures.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_AIRFLOW}"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_AIRFLOW}"
          },
          "rawSql": "SELECT\n  date_trunc('hour', start_date) AS time,\n  dag_id || ' / ' || state AS metric,\n  count(*) AS value\nFROM dag_run\nWHERE $__timeFilter(start_date)\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "title": "p95 DAG duration",
      "description": "95th percentile DagRun duration per DAG. A rising line means the pipeline is slowing down.",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_AIRFLOW}"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_AIRFLOW}"
          },
          "rawSql": "SELECT\n  date_trunc('hour', start_date) AS time,\n  dag_id AS metric,\n  percentile_cont(0.95) WITHIN GROUP (\n    ORDER BY extract(epoch FROM end_date - start_date)\n  ) AS value\nFROM dag_run\nWHERE state = 'success'\n  AND $__timeFilter(start_date)\n  AND end_date IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
