    {
      "id": 12,
      "title": "Missing snapshots",
      "description": "Snapshots where the number of rows differs from the number of coins. Empty is good.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CRYPTO}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CRYPTO}"
          },
          "rawSql": "SELECT\n  snapshot_at,\n  count(*) AS rows,\n  (SELECT count(*) FROM coins) AS expected\nFROM coin_snapshot\nGROUP BY snapshot_at\nHAVING count(*) <> (SELECT count(*) FROM coins)\nORDER BY snapshot_at DESC\nLIMIT 20",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
