  "panels": [
    {
      "id": 1,
      "title": "Failed runs · 24h",
      "description": "Any failed DagRun in the last 24 hours. Should be 0.",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_AIRFLOW}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_AIRFLOW}"
          },
          "rawSql": "SELECT count(*) AS failed_24h\nFROM dag_run\nWHERE state = 'failed'\n  AND start_date > now() - interval '24 hours'",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Crypto freshness",
      "description": "Seconds since the latest coin_snapshot row. Warning at 5 min, critical at 15 min.",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "${DS_CRYPTO}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "${DS_CRYPTO}"
          },
          "rawSql": "SELECT extract(epoch FROM now() - max(snapshot_at))::int AS lag_seconds\nFROM coin_snapshot",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
